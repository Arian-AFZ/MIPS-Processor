DEPTH = 18; -- The size of memory in words
WIDTH = 16; -- The size of data in bits
ADDRESS_RADIX = HEX; -- The radix for address values
DATA_RADIX = BIN; -- The radix for data values
CONTENT -- start of (address : data pairs)
%
addi $t0, $t6, 5
addi $t0, $t5, 4
mult $t5, $t6, $t5 # 4*5
no operation
addi $t0, $t4, 3
addi $t0, $t3, 2
mult $t3, $t4, $t3 # 2*3
mult $t3, $t5, $t1 # 6*20
%
BEGIN
02: 1000000110000101; -- 8185
03: 1000000101000100; -- 8144
04: 0000101110101100; -- 0BAC
05: 1000000000000000; -- 8000
06: 1000000100000011; -- 8103
07: 1000000011000010; -- 80C2
08: 0000011100011100; -- 071C
09: 0000011101001100; -- 074C
END