	end
	if (
		( RFout1test_expected_prev[7] !== 1'bx ) && ( RFout1test_prev[7] !== RFout1test_expected_prev[7] )
		&& ((RFout1test_expected_prev[7] !== last_RFout1test_exp[7]) ||
