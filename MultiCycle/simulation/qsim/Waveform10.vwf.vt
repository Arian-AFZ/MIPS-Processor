		last_RFout2test_exp[7] = RFout2test_expected_prev[7];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#2000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module MultiCycleDebug_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk1;
reg clk2;
reg clk3;
reg clk4;
// wires                                               
wire [3:0] ALUcontroltest;
wire [7:0] ALUin1test;
wire [7:0] ALUin2test;
wire [7:0] ALUtest;
wire [15:0] IMout;
wire [7:0] pc;
wire ready;
wire RegWritetest;
wire [7:0] RFdataINtest;
wire [2:0] RFin1;
wire [2:0] RFin2;
wire [2:0] RFin3;
wire [7:0] RFout1test;
wire [7:0] RFout2test;

wire sampler;                             

// assign statements (if any)                          
MultiCycleDebug i1 (
// port map - connection between master ports and signals/registers   
	.ALUcontroltest(ALUcontroltest),
	.ALUin1test(ALUin1test),
	.ALUin2test(ALUin2test),
	.ALUtest(ALUtest),
	.clk1(clk1),
	.clk2(clk2),
	.clk3(clk3),
	.clk4(clk4),
	.IMout(IMout),
	.pc(pc),
	.ready(ready),
	.RegWritetest(RegWritetest),
	.RFdataINtest(RFdataINtest),
	.RFin1(RFin1),
	.RFin2(RFin2),
	.RFin3(RFin3),
	.RFout1test(RFout1test),
	.RFout2test(RFout2test)
);

// clk1
initial
begin
	clk1 = 1'b0;
	clk1 = #60000 1'b1;
	# 30000;
	repeat(15)
	begin
		clk1 = 1'b0;
		clk1 = #30000 1'b1;
		# 30000;
	end
	repeat(16)
	begin
		clk1 = 1'b0;
		clk1 = #30000 1'b1;
		# 30000;
	end
	clk1 = 1'b0;
end 

// clk2
initial
begin
	clk2 = 1'b0;
	clk2 = #50000 1'b1;
	# 30000;
	repeat(15)
	begin
		clk2 = 1'b0;
		clk2 = #30000 1'b1;
		# 30000;
	end
	clk2 = 1'b0;
	clk2 = #30000 1'b1;
	clk2 = #10000 1'b0;
	clk2 = #30000 1'b1;
	# 30000;
	repeat(15)
	begin
		clk2 = 1'b0;
		clk2 = #30000 1'b1;
		# 30000;
	end
	clk2 = 1'b0;
end 

// clk3
initial
begin
	repeat(33)
	begin
		clk3 = 1'b0;
		clk3 = #30000 1'b1;
		# 30000;
	end
	clk3 = 1'b0;
end 

// clk4
initial
begin
	clk4 = 1'b0;
	clk4 = #50000 1'b1;
	# 30000;
	repeat(15)
	begin
		clk4 = 1'b0;
		clk4 = #30000 1'b1;
		# 30000;
	end
	repeat(15)
	begin
		clk4 = 1'b0;
		clk4 = #30000 1'b1;
		# 30000;
	end
	clk4 = 1'b0;
	clk4 = #30000 1'b1;
	clk4 = #40000 1'b0;
	clk4 = #30000 1'b1;
	clk4 = #10000 1'b0;
end 

MultiCycleDebug_vlg_sample_tst tb_sample (
	.clk1(clk1),
	.clk2(clk2),
	.clk3(clk3),
	.clk4(clk4),
	.sampler_tx(sampler)
);

MultiCycleDebug_vlg_check_tst tb_out(
	.ALUcontroltest(ALUcontroltest),
	.ALUin1test(ALUin1test),
	.ALUin2test(ALUin2test),
	.ALUtest(ALUtest),
	.IMout(IMout),
	.pc(pc),
	.ready(ready),
	.RegWritetest(RegWritetest),
	.RFdataINtest(RFdataINtest),
	.RFin1(RFin1),
	.RFin2(RFin2),
	.RFin3(RFin3),
	.RFout1test(RFout1test),
	.RFout2test(RFout2test),
	.sampler_rx(sampler)
);
endmodule

