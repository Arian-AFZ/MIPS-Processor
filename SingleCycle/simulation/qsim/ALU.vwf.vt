	in1[3] = 1'b1;
	in1[3] = #10000 1'b0;
	in1[3] = #110000 1'b1;
	in1[3] = #10000 1'b0;
end 
// in1[ 2 ]
initial
begin
	in1[2] = 1'b0;
	in1[2] = #10000 1'b1;
	in1[2] = #110000 1'b0;
end 
// in1[ 1 ]
initial
begin
	in1[1] = 1'b1;
	in1[1] = #10000 1'b0;
end 
// in1[ 0 ]
initial
begin
	in1[0] = 1'b1;
	in1[0] = #10000 1'b0;
end 
