ALU_vlg_sample_tst tb_sample (
	.clk(clk),
	.in1(in1),
	.in2(in2),
	.opcode(opcode),
	.sampler_tx(sampler)
);

ALU_vlg_check_tst tb_out(
	.ready(ready),
	.result(result),
	.zero(zero),
	.sampler_rx(sampler)
);
endmodule

